{
  "manifest_version": 2,
  "name": "Offset RP - Lens AI Extractor",
  "version": "4.0.0",
  "description": "Abre a imagem no Google Lens, anexa a query multimodal (igual à pesquisa manual), extrai os itens do AI Overview e envia-os para a calculadora OFFSET RP.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg",
    "128": "icon.svg"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Extrair do Lens",
    "default_icon": {
      "48": "icon.svg",
      "96": "icon.svg"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lensextractor@offsetrp.app",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "notifications",
    "https://lens.google.com/*",
    "https://www.google.com/*",
    "https://consent.google.com/*",
    "https://offsetrp-calculadora.vercel.app/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://lens.google.com/*",
        "https://www.google.com/search*",
        "https://consent.google.com/*"
      ],
      "js": ["lens-extract.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://offsetrp-calculadora.vercel.app/*"],
      "js": ["site-inject.js"],
      "run_at": "document_idle"
    }
  ]
}
